{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "techtalkjp",
  "main": "./worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // esbuild の keepNames を切る。既定の true だと関数を作るたびに __name() が走り、
  // 描画のたびに関数を作る remix/component では 1 リクエストあたり 0.2〜0.5ms 遅くなる。
  // minify はしていないので関数名はコードに残り、スタックトレースはソースマップで元に戻す
  "keep_names": false,
  "upload_source_maps": true,
  // wrangler deploy / dev の前にブラウザ用バンドル（public/js、gitignore 済み）を作る。
  // dev 中は app/ と client/ の変更で作り直す
  "build": {
    "command": "pnpm build:client",
    "watch_dir": ["app", "client"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "workflows": [
    {
      "name": "techtalkjp-contact-workflow",
      "binding": "CONTACT_WORKFLOW",
      "class_name": "ContactWorkflow"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "techtalkjp",
      "database_id": "634e29d6-baee-4023-a402-c16cba3038af"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
