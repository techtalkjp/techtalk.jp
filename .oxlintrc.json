{
  "$schema": "https://oxc.rs/schema/oxlintrc.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-redeclare": "off",
    "no-unused-vars": "off",
    "require-await": "error",
    "no-shadow": "error"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/__tests__/**"
      ],
      "rules": {
        "require-await": "off"
      }
    }
  ],
  "ignorePatterns": ["public/js/**", "worker-configuration.d.ts"]
}
