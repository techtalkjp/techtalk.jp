{
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.4.1 <13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "pnpm build:widget && NODE_ENV=production react-router build",
    "dev": "react-router dev",
    "start": "wrangler dev",
    "typegen": "wrangler types",
    "lint": "vp lint -c .oxlintrc.json",
    "format": "vp fmt -c .oxfmtrc.json --check",
    "format:fix": "vp fmt -c .oxfmtrc.json",
    "typecheck": "react-router typegen && tsc",
    "validate": "run-p format lint typecheck",
    "deploy": "NODE_ENV=production wrangler deploy",
    "migrations:list": "wrangler d1 migrations list techtalkjp --local",
    "migrations:apply": "wrangler d1 migrations apply techtalkjp --local",
    "migrations:apply:production": "wrangler d1 migrations apply techtalkjp --remote",
    "build:widget": "vite build -c vite.config.web-component.ts",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.64",
    "@ai-sdk/openai": "4.0.60",
    "@ai-sdk/react": "4.0.96",
    "@coji/kysely-duckdb-wasm": "0.4.0",
    "@conform-to/react": "1.21.1",
    "@conform-to/zod": "1.21.1",
