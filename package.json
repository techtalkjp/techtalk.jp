{
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.4.1 <13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "portless run --name techtalk sh -c 'exec wrangler dev --port \"${PORT:-8787}\"'",
    "build": "pnpm build:client",
    "build:client": "pnpm fonts:ensure && rm -rf public/js && esbuild client/entry.ts --bundle --format=esm --outdir=public/js --jsx=automatic --jsx-import-source=remix/component --minify --target=es2022",
    "fonts:build": "uv run scripts/build-fonts.py",
    "fonts:check": "node scripts/check-fonts.mjs",
    "fonts:ensure": "node scripts/check-fonts.mjs --ensure",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types --env-file .env.example",
    "typecheck": "tsc",
    "lint": "oxlint -c .oxlintrc.json",
    "format": "oxfmt -c .oxfmtrc.json --check",
    "format:fix": "oxfmt -c .oxfmtrc.json",
    "test": "remix test",
    "validate": "pnpm fonts:ensure && run-p format lint typecheck test fonts:check",
    "migrations:list": "wrangler d1 migrations list techtalkjp --local",
    "migrations:apply": "wrangler d1 migrations apply techtalkjp --local",
    "migrations:apply:production": "wrangler d1 migrations apply techtalkjp --remote",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "mimetext": "3.0.28",
    "remix": "3.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260926.1",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "lefthook": "2.1.14",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "portless": "0.15.6",
    "typescript": "7.0.2",
    "wrangler": "4.141.0"
  }
}
