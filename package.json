{
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.4.1 <13"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "run-p dev:client dev:worker",
    "dev:client": "pnpm build:client --watch",
    "dev:worker": "wrangler dev",
    "build": "pnpm build:client",
    "build:client": "esbuild client/entry.ts client/islands.ts --bundle --splitting --format=esm --outdir=public/js --jsx=automatic --jsx-import-source=remix/component --minify --target=es2022 '--entry-names=[name]' '--chunk-names=chunk-[hash]'",
    "deploy": "pnpm build && wrangler deploy",
    "typegen": "wrangler types --env-file .env.example",
    "typecheck": "tsc",
    "lint": "oxlint -c .oxlintrc.json",
    "format": "oxfmt -c .oxfmtrc.json --check",
    "format:fix": "oxfmt -c .oxfmtrc.json",
    "test": "remix test",
    "validate": "run-p format lint typecheck test",
    "migrations:list": "wrangler d1 migrations list techtalkjp --local",
    "migrations:apply": "wrangler d1 migrations apply techtalkjp --local",
    "migrations:apply:production": "wrangler d1 migrations apply techtalkjp --remote",
    "prepare": "lefthook install || true"
  },
  "dependencies": {
    "@remix-run/ui": "0.12.1",
    "mimetext": "3.0.28",
    "neverthrow": "8.2.0",
    "remix": "3.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260926.1",
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "lefthook": "2.1.14",
    "npm-run-all": "4.1.5",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "wrangler": "4.141.0"
  }
}
